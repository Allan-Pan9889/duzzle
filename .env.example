# Local dev (macOS Homebrew Postgres, replace `a1` with your system username)
DATABASE_URL="postgresql://a1@localhost:5432/duzzle"
# Docker alternative: postgresql://duzzle:duzzle@localhost:5432/duzzle
# Production (Neon): postgresql://user:pass@host:5432/duzzle
JWT_SECRET="change-me-in-production"

# SabPaisa PG 3.0
SABPAISA_API_KEY=""
SABPAISA_SECRET_KEY=""
SABPAISA_MERCHANT_ID=""
SABPAISA_WEBHOOK_SECRET=""
# Staging: https://staging-sb-merchant-api.sabpaisa.in
# Production: https://merchant-api.sabpaisa.in
# Staging (default if unset): https://staging-sb-merchant-api.sabpaisa.in
# Production (shop.duzzlese.com): https://merchant-api.sabpaisa.in
SABPAISA_BASE_URL="https://staging-sb-merchant-api.sabpaisa.in"

ADMIN_EMAIL="admin@duzzle.com"
ADMIN_PASSWORD="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Minibe OTP SMS — POST http://sms-api.minibe.net/sms/send
OTP_API_KEY=""
OTP_API_SECRET=""
OTP_APP_ID=""
# OTP_API_URL="http://sms-api.minibe.net/sms/send"

# Staging / local testing: skip SMS, use fixed OTP (remove in production)
# OTP_DEV_CODE="123456"
# NEXT_PUBLIC_OTP_DEV_CODE="123456"
